{
  "$schema": "https://cdn.jsdelivr.net/npm/@tscircuit/cli/types/tscircuit.config.schema.json",
  "mainEntrypoint": "index.circuit.tsx",
  "previewComponentPath": "index.circuit.tsx",
  "includeBoardFiles": [
    "index.circuit.tsx"
  ],
  "ignoredFiles": [
    "node_modules/**",
    "dist/**",
    "work/**",
    ".local-validation/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "firmware/build/**",
    "**/*.step"
  ],
  "alwaysUseLatestTscircuitOnCloud": true,
  "buildCommand": "bun scripts/build.mjs",
  "build": {
    "drawings": true
  },
  "siteDefaultComponentPath": "index.circuit.tsx"
}
