{
  "name": "@tsci/rushabhcodes.fidget-counter",
  "version": "1.0.40",
  "description": "Circular CR2450-powered nRF52810 BLE fidget rotation counter with TMAG3001 angle sensor",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev index.circuit.tsx",
    "start": "tsci dev index.circuit.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.mjs",
    "build:source": "tsci build index.circuit.tsx --ignore-config --disable-parts-engine",
    "build:drawings": "bun scripts/build.mjs",
    "test": "bun test",
    "check:assembly": "bun validation/check-assembly-structure.mjs && bun validation/check-device.mjs",
    "check:programming": "bun validation/check-programming.mjs",
    "check:imports": "bun validation/check-imports.mjs",
    "cad:build": "python mechanical/build_enclosure.py",
    "cad:export": "python mechanical/export_models.py"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.0.0"
  },
  "author": "rushabhcodes",
  "dependencies": {
    "@tsci/tscircuit.standard-jst-programmer": "0.8.0",
    "tscircuit": "0.0.3236",
    "@tscircuit/core": "0.0.2418",
    "@tscircuit/props": "0.0.735",
    "@tscircuit/circuit-json-util": "0.0.131",
    "circuit-json": "0.0.552",
    "circuit-json-to-gltf": "0.0.164",
    "circuit-json-to-pnp-csv": "0.0.20",
    "poppygl": "0.0.38",
    "gl-matrix": "3.4.4",
    "react": "19.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rushabhcodes/fidget-counter.git"
  },
  "homepage": "https://tscircuit.com/rushabhcodes/fidget-counter"
}
