{
  "name": "@tsci/rushabhcodes.fidget-counter",
  "version": "1.0.0",
  "description": "Circular CR2032-powered nRF52810 BLE fidget rotation counter with TMAG3001 angle sensor",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build published.circuit.json --pcb-png --schematic-png --svgs",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "check:all": "bun verify.mjs",
    "build:source": "tsci build index.circuit.tsx"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tscircuit": "0.0.2748",
    "typescript": "^5.0.0"
  },
  "author": "rushabhcodes",
  "dependencies": {
    "@tsci/seveibar.nrf52810": "0.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rushabhcodes/fidget-counter.git"
  },
  "homepage": "https://tscircuit.com/rushabhcodes/fidget-counter"
}
