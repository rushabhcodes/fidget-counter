{
  "name": "@tsci/rushabhcodes.fidget-counter",
  "version": "1.0.22",
  "description": "Circular CR2032-powered nRF52810 BLE fidget rotation counter with TMAG3001 angle sensor",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build published.circuit.json --pcb-png --schematic-png --svgs --glbs --disable-parts-engine",
    "build:cloud": "bun cloud-build.mjs",
    "build:cloud:prepare": "bun validation/prepare-cloud-assets.mjs",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "build:source": "tsci build index.circuit.tsx --glbs --disable-parts-engine",
    "check:enclosure": "bun validation/check-enclosure.mjs",
    "check:assembly": "bun validation/check-assembly-structure.mjs && bun run check:enclosure",
    "check:programming": "bun validation/check-programming.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "jszip": "3.10.1",
    "typescript": "^5.0.0"
  },
  "author": "rushabhcodes",
  "dependencies": {
    "@tsci/seveibar.nrf52810": "0.1.3",
    "@tsci/tscircuit.standard-jst-programmer": "0.8.0",
    "tscircuit": "0.0.2748"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rushabhcodes/fidget-counter.git"
  },
  "homepage": "https://tscircuit.com/rushabhcodes/fidget-counter"
}
